# Database
POSTGRES_DB=bdlocator
POSTGRES_USER=bdlocator
POSTGRES_PASSWORD=changeme

# CQC API — subscription key from https://api-portal.service.cqc.org.uk
CQC_SUBSCRIPTION_KEY=

# LLM
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Google OAuth — https://console.cloud.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth v5
AUTH_URL=http://localhost:3000
AUTH_SECRET=                        # generate with: openssl rand -base64 32

# Mapbox — free tier token from https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# API URL (frontend → backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# CORS (backend → frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
